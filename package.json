{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "vite build && node scripts/build-wink-warm.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "npm run verify:wink-bridge",
    "sync:wink-bridge": "node scripts/sync-wink-bridge.mjs",
    "verify:wink-bridge": "node scripts/verify-wink-bridge.mjs",
    "verify:wink-config": "node scripts/verify-game-config.mjs",
    "verify:docker-headers": "node scripts/verify-docker-headers.mjs",
    "generate:wink-config": "node scripts/generate-wink-runtime-config.mjs",
    "certify:c4": "node scripts/certify-wink-c4.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "0.487.0",
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "tailwindcss": "4.1.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  }
}
